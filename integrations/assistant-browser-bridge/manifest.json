{
  "manifest_version": 3,
  "name": "YoWidgets Assistant Bridge",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "description": "Attach browser tabs to YoWidgets and approve browser agent actions.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}