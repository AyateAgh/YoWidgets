{
  "manifest_version": 3,
  "name": "YoWidgets SoundCloud Bridge",
  "version": "0.5.2",
  "minimum_chrome_version": "116",
  "description": "Connect the real SoundCloud Shuffle and Repeat controls to YoWidgets. No audio capture.",
  "key": "",
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://soundcloud.com/*",
    "http://127.0.0.1:37891/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*"
      ],
      "js": [
        "soundcloud.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
