<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>../../assets/YoWidgets.ico</ApplicationIcon><AssemblyName>YoWidgets</AssemblyName><Version>0.6.0</Version></PropertyGroup>
 <PropertyGroup Condition="'$(Configuration)' == 'Release'">
  <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract><DebugType>embedded</DebugType>
 </PropertyGroup>
 <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
 <ItemGroup><InternalsVisibleTo Include="YoWidgets.Assistant.Tests" /><InternalsVisibleTo Include="YoWidgets.Platform.UiTests" /><PackageReference Include="ClosedXML" Version="0.105.1" /><PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" /><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" /><PackageReference Include="PdfPig" Version="0.1.16" /><PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.4" /><PackageReference Include="System.Speech" Version="10.0.0" /></ItemGroup>
 <ItemGroup><ProjectReference Include="../YoWidgets.Core/YoWidgets.Core.csproj" /><PackageReference Include="System.Management" Version="10.0.0" /><Resource Include="../../shaders/Glass.ps" Link="Glass.ps" /><EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" /></ItemGroup>
 <ItemGroup><EmbeddedResource Include="Assets/**/*.svg" /><EmbeddedResource Include="Assets/**/LICENSE.txt" /></ItemGroup>
 <ItemGroup><EmbeddedResource Include="../../integrations/assistant-browser-bridge/*.*" Exclude="../../integrations/assistant-browser-bridge/*.test.cjs" LogicalName="AssistantBridge.%(Filename)%(Extension)" /></ItemGroup>
 <ItemGroup><EmbeddedResource Include="../../catalog/v1/catalog.json" LogicalName="YoWidgets.CatalogSeed.json" /><EmbeddedResource Include="../../artifacts/premium-ui.zip" LogicalName="YoWidgets.PremiumUi.zip" Condition="Exists('../../artifacts/premium-ui.zip')" /></ItemGroup>
</Project>
